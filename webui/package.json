{
  "name": "langarr-webui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:next\"",
    "dev:next": "next dev",
    "dev:server": "ts-node --transpile-only --project tsconfig.server.json server/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "ts-node --transpile-only --project tsconfig.server.json server/tests/audioTagProcessor.test.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "bowser": "^2.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "formik": "^2.4.9",
    "iso-639-1": "^3.1.6",
    "js-yaml": "^5.4.2",
    "next": "16.3.8",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.6.1",
    "reflect-metadata": "^0.2.2",
    "swr": "^2.5.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint"
    ]
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3": true,
    "unrs-resolver": true,
    "fsevents": false
  }
}
